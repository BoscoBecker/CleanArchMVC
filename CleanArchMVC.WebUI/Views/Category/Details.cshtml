@model CleanArchMVC.Application.DTOs.CategoryDTO

<h3>Category Details</h3>

<div>
	<hr/>
	<dl class="row">
		<dt class="col-sm-2">
			ID - @Model.Id
		</dt>
		<hr/>
		<dt class="col-sm-10">
			<strong>Name</strong> - @Html.DisplayFor(model => model.Name)
		</dt>	
	</dl>
	<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
	<a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
